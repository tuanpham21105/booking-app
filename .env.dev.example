# ==========================================
# DOCKER COMPOSE DEV ENVIRONMENT VARIABLES
# ==========================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này để tạo file môi trường dev:
#    cp .env.dev.example .env
# 2. Tùy chỉnh các giá trị bên dưới nếu cần thiết.
#
# LƯU Ý BẢO MẬT:
# Tuyệt đối KHÔNG commit file .env chứa thông tin bí mật lên Git.

# ------------------------------------------
# 1. Database Configuration (PostgreSQL 16-alpine)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=booking_db
POSTGRES_PORT=5432

# ------------------------------------------
# 2. Backend Configuration (NestJS 12)
# ------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000

# Cấu hình kết nối Database cho Backend
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=booking_db

# ------------------------------------------
# 3. Frontend Configuration (React 19 + Vite 8)
# ------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
