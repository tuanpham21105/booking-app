NODE_ENV=development
PORT=3000

# Cấu hình kết nối Database cho Backend
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=booking_db

# Cấu hình tài khoản Admin khởi tạo duy nhất
INITIAL_ADMIN_NAME=System Admin
INITIAL_ADMIN_EMAIL=admin@bookingapp.com
INITIAL_ADMIN_PASSWORD=AdminPassword123@

# Cấu hình JWT Xác thực & Phân quyền
JWT_SECRET=booking-app-jwt-secret-key-32-characters-min-safety
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

